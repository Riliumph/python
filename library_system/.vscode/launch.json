{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "remote debug",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "host.docker.internal",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "/opt/django"
                }
            ]
        },
        {
            "name": "local debug",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:8000"
            ],
            "django": true,
            "justMyCode": false
        }
    ]
}
